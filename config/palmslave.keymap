#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/*
 * Cheapino2(Vial) -> Palmslave(ZMK) 移植
 *
 * 並び順（1レイヤー38キー）:
 *   1行目: 左5キー | 右5キー
 *   2行目: 左5キー | 右5キー
 *   3行目: 左5キー | 右5キー
 *   4行目(親指): 左4キー(外→内) | 右4キー(内→外)
 *
 * Vialのマクロ M5〜M8 は単純なキーの同時押しなので、マクロを使わず &kp で表現:
 *   M5 = Ctrl+J / M6 = Ctrl+K / M7 = Cmd+Shift+3 / M8 = Cmd+Shift+4
 *
 * Layer 3 は Bluetooth/システム用（Vialの旧Layer 3=LED制御の代わり）。
 * Layer 1 の右内側親指 / Layer 2 の左内側親指 の &mo 3 で入る（旧MO(3)と同じ位置）。
 */

/ {
	keymap {
		compatible = "zmk,keymap";

		layer_0 {
			display-name = "Base";
			bindings = <
	&kp Q &kp W &kp E     &kp R   &kp T      &kp Y &kp U &kp I     &kp O   &kp P
	&kp A &kp S &kp D     &kp F   &kp G      &kp H &kp J &kp K     &kp L   &kp BSPC
	&kp Z &kp X &kp C     &kp V   &kp B      &kp N &kp M &kp COMMA &kp DOT &kp MINUS
	      &kp LCTRL &kp LGUI &kp SPACE &mo 1   &mo 2 &kp RET &kp RSHFT &kp RALT
			>;
		};

		layer_1 {
			display-name = "Num/Nav";
			bindings = <
	&kp N1    &kp N2          &kp N3          &kp N4   &kp N5      &kp N6    &kp N7    &kp N8  &kp N9    &kp N0
	&kp GRAVE &kp LG(LS(N3))  &kp LG(LS(N4))  &kp SEMI &kp SQT     &kp RALT  &kp PG_UP &kp UP  &kp PG_DN &kp RCTRL
	&kp ESC   &kp LANG2       &kp LANG1       &kp LC(J) &kp LC(K)  &kp FSLH  &kp LEFT  &kp DOWN &kp RIGHT &kp QMARK
	          &none &kp LGUI &kp TAB &trans    &mo 3 &kp DEL &kp RSHFT &none
			>;
		};

		layer_2 {
			display-name = "Sym/Fn";
			bindings = <
	&kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT    &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR
	&kp F1   &kp F2 &kp F3   &kp F4   &kp F5       &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH
	&kp F6   &kp F7 &kp F8   &kp F9   &kp F10      &kp UNDER &kp PLUS  &kp LBRC &kp RBRC &kp PIPE
	         &none &kp LGUI &kp LCTRL &mo 3        &trans &kp RSHFT &kp RALT &none
			>;
		};

		layer_3 {
			display-name = "BT/System";
			bindings = <
	&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none &none      &none &none &none &none &studio_unlock
	&none        &none        &none        &none &none      &none &none &none &none &out OUT_TOG
	&bt BT_CLR   &none        &none        &none &none      &none &none &none &none &bootloader
	             &none &none &none &trans                   &trans &none &none &none
			>;
		};
	};
};
