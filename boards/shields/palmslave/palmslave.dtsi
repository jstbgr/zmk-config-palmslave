/*
 * Palmslave (takashicompany) - ZMK shield
 * 元定義: qmk_firmware/keyboards/takashicompany/palmslave/keyboard.json
 *   diode_direction: COL2ROW
 *   左手: cols D4,C6,D7,E6,B4 / rows F4,F5,F6,F7
 *   右手: cols B4,E6,D7,C6,D4 / rows F4,F5,F6,F7 （基板反転のため列順が逆）
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
	chosen {
		zmk,kscan = &kscan0;
		zmk,physical-layout = &physical_layout0;
	};

	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		diode-direction = "col2row";
		wakeup-source;
	};

	/* 4行 x 10列（左5列 + 右5列）。右手は overlay 側で col-offset = 5 */
	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <10>;
		rows = <4>;
		map = <
	RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
	RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
	RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
	        RC(3,1) RC(3,2) RC(3,3) RC(3,4)   RC(3,5) RC(3,6) RC(3,7) RC(3,8)
		>;
	};

	/* 物理配置（単位: 1/100 キー。keyboard.json の x,y を100倍、w/h=84）
	 * keys の並びは上の map と同じ順 */
	physical_layout0: physical_layout_0 {
		compatible = "zmk,physical-layout";
		display-name = "Palmslave";
		transform = <&default_transform>;
		keys
			// row 0
			= <&key_physical_attrs 84 84   0  42 0 0 0>
			, <&key_physical_attrs 84 84  84  21 0 0 0>
			, <&key_physical_attrs 84 84 168   0 0 0 0>
			, <&key_physical_attrs 84 84 252  21 0 0 0>
			, <&key_physical_attrs 84 84 336  42 0 0 0>
			, <&key_physical_attrs 84 84 630  42 0 0 0>
			, <&key_physical_attrs 84 84 714  21 0 0 0>
			, <&key_physical_attrs 84 84 798   0 0 0 0>
			, <&key_physical_attrs 84 84 882  21 0 0 0>
			, <&key_physical_attrs 84 84 966  42 0 0 0>
			// row 1
			, <&key_physical_attrs 84 84   0 126 0 0 0>
			, <&key_physical_attrs 84 84  84 105 0 0 0>
			, <&key_physical_attrs 84 84 168  84 0 0 0>
			, <&key_physical_attrs 84 84 252 105 0 0 0>
			, <&key_physical_attrs 84 84 336 126 0 0 0>
			, <&key_physical_attrs 84 84 630 126 0 0 0>
			, <&key_physical_attrs 84 84 714 105 0 0 0>
			, <&key_physical_attrs 84 84 798  84 0 0 0>
			, <&key_physical_attrs 84 84 882 105 0 0 0>
			, <&key_physical_attrs 84 84 966 126 0 0 0>
			// row 2
			, <&key_physical_attrs 84 84   0 210 0 0 0>
			, <&key_physical_attrs 84 84  84 189 0 0 0>
			, <&key_physical_attrs 84 84 168 168 0 0 0>
			, <&key_physical_attrs 84 84 252 189 0 0 0>
			, <&key_physical_attrs 84 84 336 210 0 0 0>
			, <&key_physical_attrs 84 84 630 210 0 0 0>
			, <&key_physical_attrs 84 84 714 189 0 0 0>
			, <&key_physical_attrs 84 84 798 168 0 0 0>
			, <&key_physical_attrs 84 84 882 189 0 0 0>
			, <&key_physical_attrs 84 84 966 210 0 0 0>
			// row 3 (thumb)
			, <&key_physical_attrs 84 84 168 315 0 0 0>
			, <&key_physical_attrs 84 84 252 315 0 0 0>
			, <&key_physical_attrs 84 84 336 315 0 0 0>
			, <&key_physical_attrs 84 84 420 315 0 0 0>
			, <&key_physical_attrs 84 84 546 315 0 0 0>
			, <&key_physical_attrs 84 84 630 315 0 0 0>
			, <&key_physical_attrs 84 84 714 315 0 0 0>
			, <&key_physical_attrs 84 84 798 315 0 0 0>
			;
	};
};
